# Fly.io ignore file
# Files and directories to exclude from deployment

# Git files
.git
.gitignore
.github

# Documentation
docs/
README*.md
*.md

# Development files
.vscode
.idea
*.swp
*.swo
*~

# Build artifacts
target/
dist/
build/
*.log

# Data files
data/
*.db
*.sled

# Environment files
.env
.env.local
.env.*.local

# Test files
tests/
**/*_test.rs
**/*.test.ts
**/*.test.js

# Proofs
proofs/
scripts/

# Examples
examples/

# JSON-LD files (keep only if needed)
# *.jsonld
