  "incdb:components": [
    {
      "@id": "incdb:ComponentCore",
      "rdfs:label": "incdb-core",
      "rdfs:comment": "コアライブラリ（Incidence Foundation、WorldGraph、EventSourcedGraph）",
      "incdb:status": "completed",
      "incdb:testCount": 21,
      "incdb:integrationTestCount": 3,
      "incdb:features": [
        "WorldGraph: インメモリグラフ構造",
        "EventSourcedGraph: イベントソーシングベースのグラフ（1000億〜10兆レコード対応）",
        "Event Model: イベント構造とEventType enum",
        "GraphWrapper: WorldGraphとEventSourcedGraphの統一インターフェース"
      ]
    },
    {
      "@id": "incdb:ComponentStorage",
      "rdfs:label": "incdb-storage",
      "rdfs:comment": "ストレージ層（永続化、インデックス、イベントソーシング）",
      "incdb:status": "completed",
      "incdb:features": [
        "SledBackend: 永続化ストレージ",
        "EventStream: 時系列順イベント保存・取得",
        "SnapshotStore: 圧縮スナップショット管理（10:1圧縮率）",
        "EntityStateStore: エンティティ状態管理",
        "HNSWVectorIndex: HNSWベースの高速ベクトル検索（O(log n)）",
        "TemporalCompression: Delta Encoding + Product Quantization",
        "ProductQuantization: ベクトル量子化（128次元 → 8 bytes）"
      ]
    },
    {
      "@id": "incdb:ComponentQuery",
      "rdfs:label": "incdb-query",
      "rdfs:comment": "クエリエンジン（Incidence Datalog、パターンマッチ）",
      "incdb:status": "completed"
    },
    {
      "@id": "incdb:ComponentAPI",
      "rdfs:label": "incdb-api",
      "rdfs:comment": "API層（gRPC/GraphQL、EventSourcedGraph対応）",
      "incdb:status": "completed",
      "incdb:note": "GraphQL は動作確認済み。EventSourcedGraph用のGraphQLスキーマを実装。gRPC はオプショナル機能（macOS では追加設定が必要）",
      "incdb:features": [
        "GraphQL API: WorldGraph用とEventSourcedGraph用の2つのスキーマ",
        "時系列範囲クエリ: incidencesByTimeRange",
        "エンティティtraversal: traverseEntity",
        "コンテキスト付きベクトル検索: vectorSearch（タイムスタンプ範囲、エンティティフィルタ対応）",
        "環境変数USE_EVENT_SOURCINGでEventSourcedGraphモードを切り替え可能"
      ]
    },
    {
      "@id": "incdb:ComponentCLI",
      "rdfs:label": "incdb-cli",
      "rdfs:comment": "CLIツール（EventSourcedGraph対応）",
      "incdb:status": "completed",
      "incdb:features": [
        "ベンチマークコマンド: benchmark-write, benchmark-read, benchmark-multi-hop, benchmark-vector-hop",
        "環境変数USE_EVENT_SOURCINGでEventSourcedGraphモードを切り替え可能",
        "大規模データベンチマーク対応（10万レコード規模）"
      ]
    },
    {
      "@id": "incdb:ComponentWeb",
      "rdfs:label": "incdb-web",
      "rdfs:comment": "Web UI（SvelteKit）",
      "incdb:status": "completed",
      "incdb:note": "SvelteFlow (@xyflow/svelte) を使用したグラフ可視化を実装。vis-network から移行完了。Vector ページは Plotly.js を CDN から読み込み。Paper ページを追加し、Incidence-only Foundationの学術論文とLean証明結果を表示。Docker Compose で正常動作確認済み。",
      "incdb:pages": [
        "Home",
        "Schema",
        "Query",
        "View",
        "Graph",
        "Vector",
        "Benchmark",
        "Paper"
      ]
    }
  ],
