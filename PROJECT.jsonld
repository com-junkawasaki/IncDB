    "prov:startedAtTime": {
      "@type": "xsd:dateTime",
      "@value": "2024-01-01T00:00:00Z"
    }
  },
  "rdfs:label": "IncDB Project",
  "rdfs:comment": "Incidence-only Foundation を実装するグラフ+ベクターデータベースシステム",
