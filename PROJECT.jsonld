{
  "@context": {
    "prov": "http://www.w3.org/ns/prov#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "incdb": "http://example.org/incdb#"
  },
  "@id": "incdb:Project",
  "@type": "prov:Project",
  "prov:wasStartedBy": {
    "@id": "incdb:ProjectStart",
    "@type": "prov:Activity",
    "prov:startedAtTime": {
      "@type": "xsd:dateTime",
      "@value": "2024-01-01T00:00:00Z"
    }
  },
  "rdfs:label": "IncDB Project",
  "rdfs:comment": "Incidence-only Foundation を実装するグラフ+ベクターデータベースシステム",
  "incdb:version": "0.1.0",
  "incdb:status": "completed",
  "incdb:completedAt": {
    "@type": "xsd:dateTime",
    "@value": "2024-12-19T00:00:00Z"
  },
  "prov:wasInfluencedBy": [
    {
      "@id": "incdb:ActivitySvelteFlowMigration",
      "@type": "prov:Activity",
      "rdfs:label": "SvelteFlow Migration",
      "rdfs:comment": "グラフ可視化ライブラリを vis-network から SvelteFlow に移行",
      "prov:startedAtTime": {
        "@type": "xsd:dateTime",
        "@value": "2025-12-06T07:40:00Z"
      },
      "prov:endedAtTime": {
        "@type": "xsd:dateTime",
        "@value": "2025-12-06T07:47:00Z"
      },
      "incdb:changes": [
        "vis-network を削除し @xyflow/svelte をインストール",
        "Graph ページを SvelteFlow コンポーネントに書き換え",
        "Vector ページの plotly.js-dist-min を CDN から読み込むように変更",
        "Vite 設定を更新して SSR 対応を改善",
        "Docker Compose でビルド・動作確認完了"
      ],
      "incdb:status": "completed"
    }
  ],
  "incdb:components": [
    {
      "@id": "incdb:ComponentCore",
      "rdfs:label": "incdb-core",
      "rdfs:comment": "コアライブラリ（Incidence Foundation、WorldGraph）",
      "incdb:status": "completed",
      "incdb:testCount": 21,
      "incdb:integrationTestCount": 3
    },
    {
      "@id": "incdb:ComponentStorage",
      "rdfs:label": "incdb-storage",
      "rdfs:comment": "ストレージ層（永続化、インデックス）",
      "incdb:status": "completed"
    },
    {
      "@id": "incdb:ComponentQuery",
      "rdfs:label": "incdb-query",
      "rdfs:comment": "クエリエンジン（Incidence Datalog、パターンマッチ）",
      "incdb:status": "completed"
    },
    {
      "@id": "incdb:ComponentAPI",
      "rdfs:label": "incdb-api",
      "rdfs:comment": "API層（gRPC/GraphQL）",
      "incdb:status": "completed",
      "incdb:note": "GraphQL は動作確認済み。gRPC はオプショナル機能（macOS では追加設定が必要）"
    },
    {
      "@id": "incdb:ComponentCLI",
      "rdfs:label": "incdb-cli",
      "rdfs:comment": "CLIツール",
      "incdb:status": "completed"
    },
    {
      "@id": "incdb:ComponentWeb",
      "rdfs:label": "incdb-web",
      "rdfs:comment": "Web UI（SvelteKit）",
      "incdb:status": "completed",
      "incdb:note": "SvelteFlow (@xyflow/svelte) を使用したグラフ可視化を実装。vis-network から移行完了。Vector ページは Plotly.js を CDN から読み込み。Docker Compose で正常動作確認済み。"
    }
  ],
  "incdb:examples": [
    {
      "@id": "incdb:ExampleBasicUsage",
      "rdfs:label": "basic_usage",
      "rdfs:comment": "基本機能の使用例",
      "incdb:status": "completed"
    },
    {
      "@id": "incdb:ExampleQuery",
      "rdfs:label": "query_example",
      "rdfs:comment": "クエリの使用例",
      "incdb:status": "completed"
    },
    {
      "@id": "incdb:ExampleStorage",
      "rdfs:label": "storage_example",
      "rdfs:comment": "ストレージの使用例",
      "incdb:status": "completed"
    }
  ],
  "incdb:documentation": [
    {
      "@id": "incdb:DocAPI",
      "rdfs:label": "API Documentation",
      "rdfs:comment": "API ドキュメント",
      "incdb:path": "docs/API.md"
    },
    {
      "@id": "incdb:DocUsage",
      "rdfs:label": "Usage Guide",
      "rdfs:comment": "使用ガイド",
      "incdb:path": "docs/USAGE.md"
    },
    {
      "@id": "incdb:DocGRPC",
      "rdfs:label": "gRPC Documentation",
      "rdfs:comment": "gRPC API ドキュメント",
      "incdb:path": "docs/GRPC.md"
    },
    {
      "@id": "incdb:DocSummary",
      "rdfs:label": "Implementation Summary",
      "rdfs:comment": "実装サマリー",
      "incdb:path": "docs/SUMMARY.md"
    }
  ]
}

